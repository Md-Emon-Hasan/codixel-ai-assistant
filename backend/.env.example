# Model config
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Knowledge base
TARGET_WEBSITE=https://your-website.com/
DOCUMENTS_DIR=./data/documents
CHROMA_PATH=./data/chroma_store

# CORS — use * for local dev only
# Production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# Business hours
OFFICE_TIMEZONE=Asia/Dhaka
OFFICE_START_HOUR=10
OFFICE_END_HOUR=17
OFFICE_DAYS=0,1,2,3,4

# Legacy admin API key (kept for backward compatibility)
ADMIN_API_KEY=your-admin-api-key

# JWT Auth — use a long random string in production (run: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default admin account (auto-created on first startup if no agents exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
